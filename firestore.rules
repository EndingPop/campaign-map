rules_version = '2';

// Access model (see the development spec):
//   admin, dm - everything: pins, waypoints, pin types, DM-only text, any
//               note, members, map settings, and writing notes under their
//               original authors when restoring a backup. The two roles have
//               the same powers; the names only show who is who.
//   player - reads revealed pins, revealed NPCs, the route, and the travel
//            modes and NPC affiliations already shown to players; reads all
//            notes on revealed pins and NPCs; writes only their own notes,
//            and may mark any visible lead open or done
// Anyone signed in but not listed in /members gets nothing.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(email()); }
    function member() { return signedIn() && exists(memberPath()); }
    function role() { return get(memberPath()).data.role; }
    // The DM has full admin powers, so both checks accept both roles.
    function isAdmin() { return member() && role() in ['admin', 'dm']; }
    function isDM() { return member() && role() in ['dm', 'admin']; }

    function isShortString(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function isOptString(v, max) { return v == null || (v is string && v.size() <= max); }

    match /members/{memberEmail} {
      // Members read the whole list (for names on notes). Anyone signed in
      // may read their own entry, so the app can tell a non-member why.
      allow read: if member() || (signedIn() && memberEmail == email());
      allow write: if isAdmin()
        && (request.method == 'delete'
            || (request.resource.data.role in ['admin', 'dm', 'player']
                && memberEmail == memberEmail.lower()));
    }

    match /settings/{docId} {
      allow read: if member();
      allow write: if isAdmin();
    }

    match /pinTypes/{typeId} {
      allow read: if member();
      allow delete: if isDM();
      allow create, update: if isDM()
        && isShortString(request.resource.data.label, 60)
        && request.resource.data.kind in ['base', 'ring']
        && isShortString(request.resource.data.color, 30)
        // `affiliationId` (optional, rings): the NPC affiliation this ring stands for.
        && isOptString(request.resource.data.get('affiliationId', null), 60);
    }

    match /pins/{pinId} {
      allow read: if isDM() || (member() && resource.data.visibility == 'public');
      allow delete: if isDM();
      allow create, update: if isDM()
        && isShortString(request.resource.data.name, 100)
        && request.resource.data.x is number
        && request.resource.data.y is number
        && request.resource.data.baseType is string
        && request.resource.data.rings is list
        && request.resource.data.visibility in ['public', 'hidden']
        && isOptString(request.resource.data.get('description', null), 5000);

      match /dm/{docId} {
        allow read, write: if isDM();
      }

      // Entries on a pin. `kind` (optional, default 'note'):
      //   note - free text
      //   lead - a lead or rumor; `status` 'open' or 'done'
      //   npc  - a person met there; `name` plus text
      match /notes/{noteId} {
        function pinIsPublic() {
          return get(/databases/$(database)/documents/pins/$(pinId)).data.visibility == 'public';
        }
        function noteShape() {
          return request.resource.data.keys().hasOnly(['text', 'authorEmail', 'authorName', 'createdAt', 'updatedAt', 'kind', 'name', 'status'])
            && isShortString(request.resource.data.text, 4000)
            && isShortString(request.resource.data.authorEmail, 200)
            && request.resource.data.get('kind', 'note') in ['note', 'lead', 'npc']
            && isOptString(request.resource.data.get('name', null), 100)
            && request.resource.data.get('status', 'open') in ['open', 'done'];
        }
        // Everyone writes only under their own email...
        function validNote() {
          return noteShape() && request.resource.data.authorEmail == email();
        }
        // ...except an admin or DM restoring a backup, which writes notes
        // back under their original authors.
        function adminRestore() {
          return isAdmin() && noteShape();
        }
        // Anyone who can see a lead may mark it open or done; nothing else changes.
        function statusOnlyOnLead() {
          return resource.data.get('kind', 'note') == 'lead'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['open', 'done'];
        }
        allow read: if isDM() || (member() && pinIsPublic());
        allow create: if member() && (isDM() || pinIsPublic()) && (validNote() || adminRestore());
        allow update: if member() && (isDM() || pinIsPublic())
          && ((resource.data.authorEmail == email() && validNote()) || statusOnlyOnLead() || adminRestore());
        allow delete: if isDM() || (member() && resource.data.authorEmail == email());
      }
    }

    match /waypoints/{waypointId} {
      allow read: if member();
      allow delete: if isDM();
      // `path` (optional): bend points along the road from the previous stop.
      // `travel` (optional): id of the travel mode used to reach this stop
      // (see travelModes); missing means 'road'.
      allow create, update: if isDM()
        && request.resource.data.seq is number
        && request.resource.data.x is number
        && request.resource.data.y is number
        && (!('path' in request.resource.data)
            || (request.resource.data.path is list && request.resource.data.path.size() <= 300))
        && (!('travel' in request.resource.data)
            || isShortString(request.resource.data.travel, 60))
        // In-game time (see settings/map timeScheme), all optional:
        // `gameDate` { year, period, day } on the campaign calendar,
        // `gameDay` a campaign day or session number, `gameDateText` free text.
        && (request.resource.data.get('gameDate', null) == null
            || (request.resource.data.gameDate is map
                && request.resource.data.gameDate.keys().hasOnly(['year', 'period', 'day'])
                && request.resource.data.gameDate.year is int
                && request.resource.data.gameDate.period is int
                && request.resource.data.gameDate.day is int))
        && (request.resource.data.get('gameDay', null) == null || request.resource.data.gameDay is number)
        && isOptString(request.resource.data.get('gameDateText', null), 100);
    }

    // What the DM is showing on the projector (presenter sync). One
    // document; the DM's app writes it, every member's app may follow it.
    match /presenter/{docId} {
      allow read: if member();
      allow write: if isDM();
    }

    // Planned routes. Party plans: any member draws, edits or deletes them.
    // DM plans live in their own collection, which players cannot read.
    function validPlan() {
      return isShortString(request.resource.data.name, 100)
        && request.resource.data.points is list
        && request.resource.data.points.size() >= 2
        && request.resource.data.points.size() <= 300
        && isShortString(request.resource.data.travel, 60)
        && isShortString(request.resource.data.createdBy, 200);
    }
    match /plans/{planId} {
      allow read, delete: if member();
      allow create, update: if member() && validPlan();
    }
    match /dmPlans/{planId} {
      allow read, delete: if isDM();
      allow create, update: if isDM() && validPlan();
    }

    // Session log, one document per play date (id YYYY-MM-DD). The DM's app
    // creates them; every member reads them and adds signed recap notes.
    match /sessions/{sessionId} {
      allow read: if member();
      allow delete: if isDM();
      allow create, update: if isDM()
        && sessionId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isOptString(request.resource.data.get('title', null), 200);

      match /notes/{noteId} {
        function noteShape() {
          return request.resource.data.keys().hasOnly(['text', 'authorEmail', 'authorName', 'createdAt', 'updatedAt'])
            && isShortString(request.resource.data.text, 4000)
            && isShortString(request.resource.data.authorEmail, 200);
        }
        function validNote() { return noteShape() && request.resource.data.authorEmail == email(); }
        function adminRestore() { return isAdmin() && noteShape(); }
        allow read: if member();
        allow create: if member() && (validNote() || adminRestore());
        allow update: if member() && ((resource.data.authorEmail == email() && validNote()) || adminRestore());
        allow delete: if isDM() || (member() && resource.data.authorEmail == email());
      }
    }
    match /sessionSecrets/{sessionId} {
      allow read, write: if isDM();
    }

    // Handouts (letters, posters, sketches) on a pin or NPC. Only the DM
    // adds them. `revealed` is the DM's switch; `visibility` is what players
    // get, and the DM's app sets it to 'public' only while the handout is
    // revealed AND its pin or NPC is visible to players.
    match /handouts/{handoutId} {
      allow read: if isDM() || (member() && resource.data.visibility == 'public');
      allow delete: if isDM();
      allow create, update: if isDM()
        && isShortString(request.resource.data.title, 200)
        && request.resource.data.parentKind in ['pin', 'npc']
        && isShortString(request.resource.data.parentId, 200)
        && request.resource.data.revealed is bool
        && request.resource.data.visibility in ['public', 'hidden']
        && isOptString(request.resource.data.get('transcription', null), 10000)
        && isOptString(request.resource.data.get('url', null), 2000);
    }

    // Uploaded images (NPC portraits, handout images) as data URLs, one per
    // document so lists never download them. Players may fetch an image only
    // by its id, which appears only in an NPC or handout they can already
    // read; they cannot list the collection.
    match /images/{imageId} {
      allow get: if member();
      allow list: if isDM();
      allow delete: if isDM();
      allow create, update: if isDM()
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000;
    }

    // Ways the party travels (road, teleport, ship...). Players read only
    // modes with `revealed` true; the DM's app sets it the first time a
    // route stop uses the mode, so an unused mode's name never reaches them.
    match /travelModes/{modeId} {
      allow read: if isDM() || (member() && resource.data.revealed == true);
      allow delete: if isDM();
      allow create, update: if isDM()
        && isShortString(request.resource.data.label, 60)
        && isShortString(request.resource.data.color, 30)
        && request.resource.data.line in ['path', 'arc']
        && request.resource.data.dash in ['dash', 'dot', 'solid']
        && request.resource.data.revealed is bool
        && request.resource.data.paces is map
        && request.resource.data.paces.keys().hasOnly(['slow', 'normal', 'fast']);
    }

    // Groups an NPC can belong to (Harpers, Zhentarim...). Same reveal rule
    // as travel modes: players read one only once it shows on a revealed NPC.
    match /affiliations/{affId} {
      allow read: if isDM() || (member() && resource.data.revealed == true);
      allow delete: if isDM();
      allow create, update: if isDM()
        && isShortString(request.resource.data.name, 60)
        && isShortString(request.resource.data.color, 30)
        && isOptString(request.resource.data.get('description', null), 2000)
        && request.resource.data.revealed is bool;
    }

    // NPCs. Only the DM creates and edits them. `pinIds` and
    // `affiliationIds` hold the links players may see; hidden links and the
    // DM's notes live in npcSecrets, which players cannot read at all.
    match /npcs/{npcId} {
      allow read: if isDM() || (member() && resource.data.visibility == 'public');
      allow delete: if isDM();
      allow create, update: if isDM()
        && isShortString(request.resource.data.name, 100)
        && request.resource.data.visibility in ['public', 'hidden']
        && request.resource.data.status in ['alive', 'dead', 'missing', 'unknown']
        && isOptString(request.resource.data.get('description', null), 5000)
        && request.resource.data.pinIds is list && request.resource.data.pinIds.size() <= 200
        && request.resource.data.affiliationIds is list && request.resource.data.affiliationIds.size() <= 50;

      // Party notes on an NPC: plain notes, same ownership rules as pin notes.
      match /notes/{noteId} {
        function npcIsPublic() {
          return get(/databases/$(database)/documents/npcs/$(npcId)).data.visibility == 'public';
        }
        function noteShape() {
          return request.resource.data.keys().hasOnly(['text', 'authorEmail', 'authorName', 'createdAt', 'updatedAt'])
            && isShortString(request.resource.data.text, 4000)
            && isShortString(request.resource.data.authorEmail, 200);
        }
        function validNote() { return noteShape() && request.resource.data.authorEmail == email(); }
        // The DM may write under another author when restoring a backup or
        // converting old "person met" entries into NPC notes.
        function adminRestore() { return isAdmin() && noteShape(); }
        allow read: if isDM() || (member() && npcIsPublic());
        allow create: if member() && (isDM() || npcIsPublic()) && (validNote() || adminRestore());
        allow update: if member() && (isDM() || npcIsPublic())
          && ((resource.data.authorEmail == email() && validNote()) || adminRestore());
        allow delete: if isDM() || (member() && resource.data.authorEmail == email());
      }
    }

    // DM-only part of each NPC (same id as the NPC): DM notes, hidden
    // location and affiliation links, and which old "person met" entries it
    // was converted from.
    match /npcSecrets/{npcId} {
      allow read, write: if isDM();
    }
  }
}
